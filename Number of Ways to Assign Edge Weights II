import sys
from typing import List
class Solution:
    def assignEdgeWeights(self, edges: List[List[int]], queries: List[List[int]]) -> List[int]:
        MOD = 10**9 + 7
        n = len(edges) + 1
        LOG = 17
        adj = [[] for _ in range(n + 1)]
        for u, v in edges:
            adj[u].append(v)
            adj[v].append(u)

        depth = [0] * (n + 1)
        up = [[0] * (n + 1) for _ in range(LOG)]
        from collections import deque
        visited = [False] * (n + 1)
        queue = deque([1])
        visited[1] = True
        up[0][1] = 1  # root's parent is itself
        while queue:
            node = queue.popleft()
            for nei in adj[node]:
                if not visited[nei]:
                    visited[nei] = True
                    depth[nei] = depth[node] + 1
                    up[0][nei] = node
                    queue.append(nei)
        # Binary lifting table
        for k in range(1, LOG):
            for v in range(1, n + 1):
                up[k][v] = up[k-1][up[k-1][v]]
        def lca(u, v):
            if depth[u] < depth[v]:
                u, v = v, u
            diff = depth[u] - depth[v]
            for k in range(LOG):
                if (diff >> k) & 1:
                    u = up[k][u]
            if u == v:
                return u
            for k in range(LOG - 1, -1, -1):
                if up[k][u] != up[k][v]:
                    u = up[k][u]
                    v = up[k][v]
            return up[0][u]
        # Precompute powers of 2
        max_pow = n + 1
        pow2 = [1] * (max_pow + 1)
        for i in range(1, max_pow + 1):
            pow2[i] = pow2[i-1] * 2 % MOD
        result = []
        for u, v in queries:
            if u == v:
                result.append(0)
                continue
            l = lca(u, v)
            k = depth[u] + depth[v] - 2 * depth[l]  # number of edges
            result.append(pow2[k - 1])
        return result

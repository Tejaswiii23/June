class Solution:
    def processStr(self, s: str) -> str:
        result = []
        for ch in s:
            if ch.islower():
                result.append(ch)
            elif ch == '*':
                if result:
                    result.pop()
            elif ch == '#':
                result = result + result  # duplicate
            elif ch == '%':
                result = result[::-1]    # reverse
        return ''.join(result)

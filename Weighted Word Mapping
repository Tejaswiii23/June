class Solution:
    def mapWordWeights(self, words: List[str], weights: List[int]) -> str:
        result = []
        for word in words:
            # Calculate the weight of the word
            word_weight = sum(weights[ord(c) - ord('a')] for c in word)
            # Take modulo 26
            mod = word_weight % 26
            # Map to letter using reverse alphabetical order (0 -> 'z', 1 -> 'y', ..., 25 -> 'a')
            mapped_char = chr(ord('z') - mod)
            result.append(mapped_char)
        return ''.join(result)
